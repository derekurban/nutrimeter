{
  "name": "nutrimeter-admin",
  "private": true,
  "version": "0.1.0",
  "description": "Nutrimeter's local review site: the submission queue, AI review through the Codex app server, and accept or reject.",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:db": "node --test --test-concurrency=1 \"test/db/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@derekurban/design-system": "github:derekurban/design-system#v0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "ajv": "^8.20.0",
    "lucide": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
